# Discord bot token (Developer Portal -> your application -> Bot -> Reset Token)
DISCORD_TOKEN=

# The Discord channel id to post new-entry announcements to
# (enable Developer Mode in Discord, then right-click the channel -> Copy Channel ID)
ANNOUNCEMENT_CHANNEL_ID=

# How often to poll MAL's "Just Added" feed for new entries, in minutes
POLL_MINUTES=5

# Where to persist the set of already-posted MAL ids, so restarts don't repost them
STATE_PATH=data/seen_entries.json

# On the very first run (no state file yet), record all currently-approved ids
# without posting them, so you don't get flooded with years of back-catalog
# entries. Set to false if you *want* every existing entry posted on first run.
PRIME_ON_FIRST_RUN=true
